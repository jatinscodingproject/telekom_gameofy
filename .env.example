PORT=4011
NODE_ENV=development
PUBLIC_BASE_URL=https://your-domain.example

# ---- Database ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=telekon_sa
DB_USER=
DB_PASSWORD=

TELKOM_ENV=production
TELKOM_ACCESS_KEY=
TELKOM_ACCESS_SECRET=
TELKOM_API_KEY=
TELKOM_REGION=eu-west-1
TELKOM_SERVICE=execute-api
TELKOM_SVC_ID=300000146
# If staging returns 403 "signature mismatch", try false (signs /subscription instead of /partner-vas-api/subscription)
TELKOM_SIGN_INCLUDE_BASE_PATH=true
# Only if Telkom confirms a different consent-gateway host (PDF spells it "vas-payment" and "vaspayment")
# TELKOM_CONSENT_BASE_URL=
# Local mock only (ignored in production):  TELKOM_BASE_URL_OVERRIDE=http://localhost:4999/partner-vas-api

# ---- Security (REQUIRED in production) ----
SESSION_SECRET=change-me-long-random-string
ADMIN_API_KEY=change-me-long-random-string
# Put this in the callback URLs you give Telkom: /api/callbacks/subscription/<token>
CALLBACK_TOKEN=change-me-long-random-string
# Comma-separated source IPs Telkom sends callbacks from (ask Telkom). Empty = not enforced.
TELKOM_CALLBACK_IPS=
# Reverse-proxy hops in front of Node (nginx/Cloudflare = 1). Needed so req.ip is real.
TRUST_PROXY=1

# ---- Behaviour ----
# Header(s) the network injects with the MSISDN on Telkom mobile data (find the real name with LOG_HEADERS=true)
MSISDN_HEADERS=x-msisdn,msisdn,x-up-calling-line-id,x-wap-msisdn,x-nokia-msisdn
LOG_HEADERS=false
ALLOW_SMS_DOI=false
ENTITLED_STATUSES=ACTIVE
ENABLE_JOBS=true

# ---- Regulatory text shown next to the SUBSCRIBE button (PDF section 5 requires it) ----
SUPPORT_CONTACT=
CANCEL_INSTRUCTIONS=
